# Copy this file to .env and fill in your Hugging Face API token.
# Get a free token at: https://huggingface.co/settings/tokens

HUGGINGFACE_API_KEY=hf_your_token_here
GROQ_API_KEY=gsk_your_groq_key_here

# Render Keep-Alive / Ping Settings (Optional)
# Render automatically sets RENDER_EXTERNAL_URL in production (e.g. https://geospeak.onrender.com).
# You can also customize the target ping URL or interval (seconds).
# KEEP_ALIVE_ENABLED=true
# KEEP_ALIVE_INTERVAL=300
# PING_URL=https://your-service.onrender.com

